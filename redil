#!/usr/bin/env php
<?php

require __DIR__ . '/vendor/autoload.php';

use Dotenv\Dotenv;
use Framework\Logger\Logger;
use App\Config\Database;
use App\Console\CommandKernel;
use App\Console\Output;
use App\Commands\{
    StartCommand,
    KeyGenerateCommand,
    MigrateCommand,
    RollbackCommand,
    MigrateStatusCommand,
    MakeMigrationCommand,
    MakeModelCommand,
    MakeControllerCommand,
    HelpCommand
};

$dotenv = Dotenv::createImmutable(__DIR__);
$dotenv->load();

try {
    Database::init();
} catch (\Throwable $e) {
    Logger::exception($e, Logger::CRITICAL);
    Output::error('Database initialization failed: ' . $e->getMessage());
    exit(1);
}

$kernel = new CommandKernel();

$kernel->register(new StartCommand());
$kernel->register(new KeyGenerateCommand());
$kernel->register(new MigrateCommand());
$kernel->register(new RollbackCommand());
$kernel->register(new MigrateStatusCommand());
$kernel->register(new MakeMigrationCommand());
$kernel->register(new MakeModelCommand());
$kernel->register(new MakeControllerCommand());
$kernel->register(new HelpCommand());

$command  = $argv[1] ?? 'help';
$args     = array_slice($argv, 2);
$exitCode = 0;

try {
    $exitCode = $kernel->call($command, $args);
} catch (\Throwable $e) {
    Logger::exception($e, Logger::CRITICAL);
    Output::error($e->getMessage());
    $exitCode = 1;
}

exit($exitCode);