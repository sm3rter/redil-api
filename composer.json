{
    "name": "redil/api",
    "description": "Redil API Framework - A lightweight PHP API framework built on Slim",
    "type": "project",
    "require": {
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.5",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Framework\\": "framework/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Middleware\\": "app/middleware/",
            "App\\": "app/"
        },
        "files": [
            "framework/Support/helpers.php",
            "framework/Support/api_helpers.php"
        ]
    },
    "config": {
        "vendor-dir": "framework/vendor"
    }
}
